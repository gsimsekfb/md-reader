{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "cargo b"
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "cargo b --release"
        },
        {
            "label": "run-debug",
            "type": "shell",
            "command": "cargo r"
        },
        {
            "label": "run-release",
            "type": "shell",
            "command": "cargo r --release"
        },
        {
            "label": "test-all",
            "type": "shell",
            "command": "cargo test --workspace --all-targets --all-features"
        },
        {
            "label": "clippy",
            "type": "shell",
            "command": "cargo clippy --workspace --all-targets --all-features"
        },
    ]
}